FROM node:22-bookworm-slim
LABEL description="Headless Penpot workspace host for the MCP plugin (fork)"

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    NODE_ENV=production

WORKDIR /opt/penpot/headless

COPY mcp/packages/headless/package.json mcp/packages/headless/package-lock.json ./

RUN set -eux; \
    npm ci --omit=dev; \
    npx playwright-core install --with-deps --only-shell chromium; \
    rm -rf /var/lib/apt/lists/* /root/.npm; \
    useradd -U -M -u 1001 -s /bin/false -d /opt/penpot/headless penpot; \
    mkdir -p /opt/penpot/headless/data; \
    chown -R penpot:penpot /opt/penpot/headless

COPY --chown=penpot:penpot mcp/packages/headless/src ./src

USER penpot:penpot

EXPOSE 4404

CMD ["node", "src/index.mjs"]
